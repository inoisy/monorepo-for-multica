            ev = last_event.get(i['key'])
            acc = 'review' if i['unmerged'] else ('success' if i['status'] == 'done' else
                                                  'failed' if ev and ev['kind'] == 'fail' else 'created')
            job = i.get('accept') or {}
            acc = ACCEPT_ICON.get(job.get('status'), acc)
            why = f"<span class='muted'>{e(job['reason'])}</span>" if job.get('reason') else ''
            chain.append(f"<span class='run' title='{e(job.get('status') or '')}'>{icon(acc)}приёмка и слияние{why}</span>")
            detail += (f"<div class='sub'><b>{e(i['key'])}</b> {e(short_title(i['title']))}</div>"
