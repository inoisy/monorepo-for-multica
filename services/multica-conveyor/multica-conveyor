        for i in shown + [i for i in unstaged if i.get('accept')]:
            if not i['jobs'] and not i['unmerged'] and not i.get('accept'):
                continue
            chain = []
            for j in i['jobs']:
                extra = ' · лимит' if j.get('quota') else ''
                chain.append(f"<span class='run' title='{e(j['status'] or '')} {e((j['at'] or '')[:16])}'>"
