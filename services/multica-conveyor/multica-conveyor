        '.arrow{color:#bfbfc3}.sub{margin-top:4px}table{border-collapse:collapse;width:100%}td,th{border-bottom:1px solid #ececef;'
        'padding:7px 8px;text-align:left;vertical-align:top}th{font-weight:600;color:#535158;font-size:13px}'
        '.k-fail,.k-error{color:#dd2b0e}.k-merge{color:#108548}.k-provider{color:#c17d10}.k-retry{color:#1f75cb}'
        'code{font-size:12px}')
    parts = [f"<div class='head'><h1>Сторож multica</h1><span class='muted'>тик {e(snapshot['tick'])} UTC · страница "
             f"обновляется каждую минуту, сторож — каждые 2</span></div>"]
    for err in snapshot.get('errors', []) + snapshot.get('provider_errors', []):
        parts.append(f"<div class='card k-error'><b>Ошибка тика:</b><pre>{e(err)}</pre></div>")
    last_event = {}
    for ev in events:
        m = re.search(r'\b([A-Z]+-\d+)\b', ev['text'].split(': ', 1)[-1])
        if m and ev['kind'] in ('merge', 'fail'):
            last_event[m.group(1)] = ev
    for ep in snapshot['epics']:
        unstaged = ep.get('unstaged', [])
        all_issues = [i for st in ep['stages'] for i in st['issues']] + unstaged
        done = sum(issue_state(i) == 'success' for i in all_issues)
        ep_state = 'success' if ep['stage'] is None else 'running'
        cols = ''
        for st in ep['stages']:
            jobs = ''.join(
                f"<div class='job' title='{e(i['title'])}'>{icon(issue_state(i))}<div class='t'>"
