        '.job .t{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.job .k{color:#737278;font-size:12px}'
        '.runs{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin:6px 0 14px}.run{display:inline-flex;align-items:center;'
