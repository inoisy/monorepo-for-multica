class AutomationPaused(Exception):
    """Оператор приостановил автоматические действия; это штатное состояние."""


def ts(s): return dt.datetime.fromisoformat(s.replace('Z', '+00:00')) if s else None
def now_utc(): return dt.datetime.now(dt.timezone.utc)


def is_quota_failure(run):
    return run.get('status') == 'failed' and (
        'quota' in (run.get('failure_reason') or '') or bool(QUOTA.search(run.get('error') or '')))


def is_infra_failure(run):
    return run.get('status') == 'failed' and not is_quota_failure(run) and (
        run.get('failure_reason') == 'runtime_recovery' or bool(INFRA.search(run.get('error') or '')))


def latest(runs): return max(runs, key=lambda r: r.get('created_at') or '') if runs else None


def infra_retry(runs, now, mem, minutes, limit):
    """Что делать с задачей, чей последний ран упал на инфраструктуре: 'retry' — повторить, 'give_up' — `limit`
    повторов подряд не помогли, ждать человека, None — ничего (идёт ран, падение не то, рано).
    mem — {'at': время прошлого повтора, 'n': повторов подряд}."""
    if not runs or any(r.get('status') in ACTIVE_RUN for r in runs):
        return None
    last = latest(runs)
    if not is_infra_failure(last):
        return None
    wait = dt.timedelta(minutes=minutes)
    if now - ts(last.get('completed_at') or last.get('created_at')) < wait:
        return None
    if (mem or {}).get('n', 0) >= limit:
        return 'give_up'
    return 'retry' if not (mem or {}).get('at') or now - ts(mem['at']) >= wait else None


def error_reset(text):
    """Сброс лимита из текста ошибки провайдера (UTC) или None. Пояс не указан — пекинское время, как у z.ai."""
    m = RESET_AT.search(text or '')
    if not m:
        return None
    zone = (m.group(3) or '').upper()
    tz = dt.timezone.utc if zone in ('Z', 'UTC') else ERROR_TZ if not zone else \
        dt.timezone((1 if zone[0] == '+' else -1) * dt.timedelta(hours=int(zone[1:3]), minutes=int(zone[-2:])))
    try:
        return dt.datetime.fromisoformat(f'{m.group(1)}T{m.group(2)}').replace(tzinfo=tz).astimezone(dt.timezone.utc)
    except ValueError:
        return None


def cooldown_until(run, now, quota, reset, restore_hours, prev=None, retry_minutes=20):
    """До какого момента не брать runtime, упавший на лимите, и какое это падение подряд.
    Сброс из текста ошибки — до него; дашборд видит упёршееся окно — до его сброса (`reset`); дашборд считает квоту
    свободной (`quota` True) — `retry_minutes`, вдвое дольше на каждом падении подряд, но не дольше `restore_hours`;
    квота неизвестна — `restore_hours`. Подряд — прошлое остывание кончилось меньше `restore_hours` назад."""
    longest = dt.timedelta(hours=restore_hours)
    prev_until = ts((prev or {}).get('until'))
    streak = prev.get('n', 1) + 1 if prev_until and now - prev_until < longest else 1
    for at in (error_reset(run.get('error')), reset if quota is False else None):
        if at and at > now:
            return at, streak
    if quota is True:
        return now + min(dt.timedelta(minutes=retry_minutes * 2 ** (streak - 1)), longest), streak
    return now + longest, streak


def is_stale(run, runtime_id):
    """Ран в очереди на другом runtime, чем сейчас у агента: multica выдаёт ран, только если runtime совпадает."""
    return run.get('status') == 'queued' and bool(run.get('runtime_id')) and bool(runtime_id) \
        and run['runtime_id'] != runtime_id


def quota_retry_plan(run, issue_runs, issue, leader_id=None):
    """Как повторить ран `run`, упавший на лимите. Повтор привязан к необработанному поручению этого рана, а не к
    статусу или исполнителю задачи. Возвращает (действие, причина):
    'wait' — по задаче идёт или ждёт ран, решим позже; 'drop' — повторять нечего;
    'rerun' — это поручение исполнителя задачи (агента или лидера сквада), его будит `issue rerun`;
    'wakeup' — входящее поручение агенту, которого `issue rerun` не разбудит (упоминание в чужой задаче) или
    задача уже на сдаче, а новое поручение не выполнено: будильник именно этому агенту."""
    if is_done(issue) or is_cancelled(issue):
        return 'drop', 'задача закрыта'
    if any(r.get('status') in control.ACTIVE for r in issue_runs):
        return 'wait', 'по задаче идёт ран'
    agent, created = run.get('agent_id'), run.get('created_at') or ''
    last = latest([r for r in issue_runs if r.get('agent_id') == agent])
    if last and last.get('id') != run.get('id'):
        return 'drop', 'после падения у агента был новый ран'
    trigger, wake = run.get('trigger_comment_id'), run.get('wakeup_id')
    for r in issue_runs:
        if r.get('status') != 'completed' or (r.get('created_at') or '') <= created:
            continue
        if (trigger and (r.get('trigger_comment_id') == trigger or trigger in (r.get('delivered_comment_ids') or []))) \
                or (wake and r.get('wakeup_id') == wake):
            return 'drop', 'поручение уже обработал другой ран'
    own = issue.get('assignee_type') in ('agent', None) and issue.get('assignee_id') == agent
    lead = issue.get('assignee_type') == 'squad' and (agent == leader_id if leader_id else bool(run.get('is_leader_task')))
    if (own or lead) and status(issue) != 'in_review':
        return 'rerun', ''
    return 'wakeup', ''


def provider_decision(runs, entry, chain_len, now, restore_hours, mode='auto', availability=None, restore_minutes=30,
                      runtime_id=None):
    """Ручной выбор и активные запуски не переключаем; свежие квоты исключают исчерпанные профили.
    Профиль выше по цепочке, подтверждённый свежей квотой, возвращается через `restore_minutes`,
    без подтверждения — только основной и только через `restore_hours`. Падение на другом runtime, чем
    текущий `runtime_id` (повтор multica на старом), не повод уезжать с текущего."""
    if mode == 'manual' or any(r.get('status') in control.ACTIVE for r in runs):
        return None
    idx, since = entry.get('idx', 0), ts(entry.get('since'))
    statuses = availability if availability is not None else [None] * chain_len
    last = latest(runs)
    failed = last and is_quota_failure(last) and (not since or ts(last.get('created_at')) >= since) \
        and not (runtime_id and last.get('runtime_id') and last['runtime_id'] != runtime_id)
    if failed or statuses[idx] is False:
        target = control.next_profile(statuses, idx + 1)
        if target is None and availability is not None:
            target = next((i for i in range(idx) if statuses[i] is True), None)
        return ('switch', target) if target is not None else ('exhausted', idx)
    better = next((i for i in range(idx) if statuses[i] is True), None)
    if better is not None and since and now - since >= dt.timedelta(minutes=restore_minutes):
        return ('restore', better)
    if idx > 0 and since and now - since >= dt.timedelta(hours=restore_hours) and statuses[0] is not False:
        return ('restore', 0)
    return None


def jobs_of(runs, names, keep=14):
    """Раны задачи как джобы пайплайна: по времени, последние `keep`."""
    def secs(r):
        a, b = ts(r.get('started_at')), ts(r.get('completed_at'))
        return int((b - a).total_seconds()) if a and b else None
    out = [{'agent': names.get(r.get('agent_id'), (r.get('agent_id') or '?')[:8]), 'status': r.get('status'),
            'at': r.get('started_at') or r.get('created_at'), 'secs': secs(r),
            'quota': is_quota_failure(r)} for r in sorted(runs, key=lambda r: r.get('created_at') or '')]
    return out[-keep:]


def status(issue): return issue.get('status') or issue.get('status_category')
def is_done(issue): return status(issue) == 'done' or issue.get('status_category') == 'done'
def is_cancelled(issue): return status(issue) in CANCELLED or issue.get('status_category') in CANCELLED
def closed(issue): return is_cancelled(issue) or (is_done(issue) and not issue.get('unmerged'))


def accept_target(issue, repo):
    """Что принимать по задаче — только из её метаданных `branch` и `commit`, без догадок по комментариям.
    {'branch', 'sha'} — коммит не в base и ветка указывает ровно на него; {'problem'} — принять нельзя, причина;
    None — коммит уже в base."""
    meta = issue.get('metadata') or {}
    branch, sha = str(meta.get('branch') or '').strip(), str(meta.get('commit') or '').strip().lower()
    if not branch or not sha:
        missing = ' и '.join(k for k, v in (('branch', branch), ('commit', sha)) if not v)
        return {'problem': f'в метаданных задачи нет {missing}'}
    if not BRANCH_NAME.fullmatch(branch) or '..' in branch:
        return {'problem': f'branch `{branch[:80]}` — недопустимое имя ветки'}
    if not SHA.fullmatch(sha):
        return {'problem': f'commit `{sha[:80]}` — не полный SHA из 40 символов'}
    if not repo.has_commit(sha):
        return {'problem': f'коммита {sha[:12]} нет в репозитории'}
    if repo.contains(sha):
        return None
    head = repo.head(f'refs/heads/{branch}')
    if not head:
        return {'problem': f'ветки `{branch}` нет в репозитории'}
    if head != sha:
        return {'problem': f'ветка `{branch}` указывает на {head[:12]}, а в метаданных commit {sha[:12]}'}
    return {'branch': branch, 'sha': sha}


def route_gate(issue):
    """Вливать ли по маршруту: None — можно; иначе причина. Решение Евгения 19.10.2026: сторож вливает в base сам,
    но только после review (и QA, если он есть в маршруте) — в `route` есть шаг review, и маршрут дошёл до `close`.
    `step` = `close` ставит только переход после pass последнего шага (или лидер руками)."""
    meta = issue.get('metadata') or {}
    route = parse_route(meta.get('route'))
    if not route:
        return 'нет `route`: вливание только после review по маршруту'
    if 'review' not in {step for step, _ in route}:
        return 'в `route` нет шага review: без review сторож не вливает, добавь `review:Техдиректор` перед `close`'
    if meta.get('step') != 'close':
        return f"маршрут не пройден: шаг `{meta.get('step')}`, вливание после `close`"
    return None


def mark_unmerged(issues, target_of):
    """Пометить задачи на сдаче (`in_review`) и в «Готово», чей коммит из метаданных ещё не в base: `unmerged` —
    его ветка, `accept` — что принимать. У задачи на сдаче, которую принять нельзя, — `accept_problem`.
    Не прошла маршрут (route_gate) — `route_wait`: в приёмку не идёт, но и закрытой не считается. Пока маршрут
    идёт, это не проблема; дошла до `close` без review или задача без `route` — `accept_problem` лидеру.
    target_of(issue) -> accept_target."""
    for i in issues:
        if not (is_done(i) or status(i) == 'in_review'):
            continue
        target = target_of(i)
        if target and target.get('sha'):
            i['unmerged'], i['accept'] = [target['branch']], target
            wait = route_gate(i)
            if wait:
                i['route_wait'] = wait
                step = (i.get('metadata') or {}).get('step')
                if status(i) == 'in_review' and (step == 'close' or not parse_route((i.get('metadata') or {}).get('route'))):
                    i['accept_problem'] = wait
        elif target and status(i) == 'in_review':
            i['accept_problem'] = target['problem']


def decide(stages):
    """По стадиям эпика — что делать сейчас. Возвращает (stage, to_accept, to_assign, held):
    stage — номер активной стадии или None, если эпик закрыт; to_accept — задачи на приёмку и слияние;
    to_assign — задачи для назначения; held — задачи, ждущие заказчика. Стадия, где открыты только ждущие,
    следующие не держит: ответ заказчика — не повод стоять независимой работе (решение Евгения, 18.10.2026)."""
    held, waiting_stage = [], None
    for st in sorted(stages, key=lambda s: s['stage']):
        open_ = [i for i in st['issues'] if not closed(i)]
        if not open_:
            continue
        held += [i for i in open_ if HOLD in (i.get('description') or '')]
        if all(i in held for i in open_):
            waiting_stage = waiting_stage or st['stage']
            continue
        to_accept = [i for i in open_ if i.get('unmerged')]
        to_assign = [i for i in open_ if not i.get('assignee_id') and i not in held]
        return st['stage'], to_accept, to_assign, held
    return waiting_stage, [], [], held


def override_levels(stages, overrides, assigning, levels):
    """Какие уровни рассуждения выставить сейчас: [(agent_id, level)].
    assigning — ключи задач, назначаемых в этом тике; levels — текущие уровни агентов {agent_id: level}."""
    issues = {i['identifier']: i for st in stages for i in st['issues']}
    out = []
    for o in overrides:
        issue = issues.get(o['issue'])
        if not issue:
            continue
        current = levels.get(o['agent_id'])
        if closed(issue):
            if current == o['thinking_level']:
                out.append((o['agent_id'], o['restore']))
        elif (issue.get('assignee_id') or o['issue'] in assigning) and current != o['thinking_level']:
            out.append((o['agent_id'], o['thinking_level']))
    return out


def already_failed(state, key, branch, pair):
    """Та же пара коммитов ветки и base уже не прошла приёмку — повторно не гонять."""
    return state.get(key, {}).get(branch) == pair


def parse_json(out):
    """JSON из вывода multica; CLI иногда дописывает после него строку-подсказку."""
    out = out.strip()
    if not out.startswith(('{', '[')):
        return {}
    return json.JSONDecoder().raw_decode(out)[0]


def items(d, key):
    return d if isinstance(d, list) else d.get(key, [])


class Multica:
    def __init__(self, ws, dry, guard=None): self.ws, self.dry, self.guard = ws, dry, guard

    def __call__(self, *a, write=False):
        if write and self.dry:
            print('  [dry-run] multica', *a)
            return {}
        if write and self.guard:
            self.guard()
        r = subprocess.run(['multica', *a, '--output', 'json'], capture_output=True, text=True, timeout=120,
                           env={**os.environ, 'MULTICA_WORKSPACE_ID': self.ws})
        if r.returncode:
            raise RuntimeError(f'multica {" ".join(a[:3])}: {r.stderr.strip()[:300]}')
        return parse_json(r.stdout)


def redact(text, secrets=()):
    """Вырезает токены из лога приёмки: значения из конфига дословно, остальное — по виду."""
    for value in secrets:
        if len(value) >= 6:
            text = text.replace(value, REDACTED)
    for pattern, replacement in SECRET_PATTERNS:
        text = pattern.sub(replacement, text)
    return text


def run_group(cmd, cwd, env, timeout, out):
    """Команда в своей группе процессов: по таймауту убивается вся группа, а не только shell.
    Возвращает код выхода или None при таймауте."""
    proc = subprocess.Popen(cmd, shell=True, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=out,
                            stderr=subprocess.STDOUT, start_new_session=True)
    try:
        return proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        # Лидер группы может выйти по TERM раньше потомков, которые TERM игнорируют, поэтому KILL шлём всей группе всегда.
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGTERM)
        with contextlib.suppress(subprocess.TimeoutExpired):
            proc.wait(timeout=KILL_GRACE)
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        return None


def accept_log_dir(): return STATE.parent / 'accept'


def prune_accept_logs(directory, now=None):
    cutoff = (now or time.time()) - ACCEPT_LOG_KEEP_DAYS * 86400
    for f in directory.glob('*.log'):
        with contextlib.suppress(OSError):
            if f.stat().st_mtime < cutoff:
                f.unlink()


class Repo:
    def __init__(self, path, base): self.path, self.base = path, base

    def git(self, *a, cwd=None, check=False):
        r = subprocess.run(['git', '-C', cwd or self.path, *a], capture_output=True, text=True)
        if check and r.returncode:
            raise RuntimeError(f'git {" ".join(a[:2])}: {r.stderr.strip()[:300]}')
        return r

    def head(self, ref): return self.git('rev-parse', '--verify', '-q', ref).stdout.strip()

    def has_commit(self, sha): return self.git('cat-file', '-e', f'{sha}^{{commit}}').returncode == 0

    def contains(self, sha):
        """Коммит уже в base."""
        return self.git('merge-base', '--is-ancestor', sha, self.base).returncode == 0

    def accept(self, ref, commands, timeout, key='', path=None, env=None, base_ref=None, label=None, busy_codes=(),
               wait_poll=60, wait_max=0, on_state=None):
        """Клон коммита `ref` + поверх `base_ref` (по умолчанию свежий base) + проверка диффа + команды приёмки.
        Возвращает {'status': passed|failed|deferred, 'reason', 'code', 'tail', 'log'}.
        path/env — acceptance_path/acceptance_env из конфига: PATH приёмки не зависит от окружения юнита.
        Код из `busy_codes` — общий ресурс занят: команда повторяется через `wait_poll` с, пока ожидание не превысит
        `wait_max` с (тогда deferred); ожидание не входит в `timeout`. on_state('waiting'|'running') — о переходах.
        Полный лог без токенов — accept/<ключ>-<sha>.log рядом с state.json; хвост берётся из него же."""
        tmp = tempfile.mkdtemp(prefix='conveyor-')
        sha = self.head(f'{ref}^{{commit}}')
        log_path = accept_log_dir() / f'{re.sub(r"[^A-Za-z0-9._-]", "_", key or ref)}-{sha[:12] or "nosha"}.log'
        secrets = [str(v) for v in (env or {}).values()]
        run_env = {**os.environ, **{k: str(v) for k, v in (env or {}).items()}}
        if path:
            run_env['PATH'] = path
        base = base_ref or f'origin/{self.base}'
        header = f'# ветка {label or ref} ({sha[:12]}), base {base}, PATH={run_env.get("PATH", "")}, ' \
                 f'переменные из acceptance_env: {sorted(env or {})}\n'
        raw = os.path.join(tmp, 'raw.log')

        def finish(status, why, extra='', code=None):
            text = Path(raw).read_text(errors='replace') if os.path.exists(raw) else ''
            ok = status == 'passed'
            body = redact(header + text + (f'{extra.strip()}\n' if extra.strip() else '') + ('' if ok else f'# {why}\n'), secrets)
            log_path.parent.mkdir(parents=True, exist_ok=True)
            prune_accept_logs(log_path.parent)
            fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, 'w') as f:
                f.write(body)
            tail = body[-1500:] if ok else f'{body[-2800:]}\nполный лог: {log_path}'
            return {'status': status, 'reason': why, 'code': code, 'tail': tail, 'log': str(log_path)}

        try:
            work = os.path.join(tmp, 'w')
            self.git('clone', '-q', '--no-checkout', self.path, work, cwd=tmp, check=True)
            self.git('checkout', '-q', '--detach', sha or ref, cwd=work, check=True)
            if self.git('merge', '--no-edit', base, cwd=work).returncode:
                return finish('failed', f'конфликт с {self.base}', self.git('diff', '--name-only', '--diff-filter=U', cwd=work).stdout)
            diff = self.git('diff', base, '--unified=0', '--', '.', ':(exclude)pnpm-lock.yaml', cwd=work).stdout
            bad = [m.group(0) for m in DIFF_GUARD.finditer(diff)]
            if bad:
                return finish('failed', 'в диффе any / as unknown as / @ts-ignore / eslint-disable', '\n'.join(bad[:10]))
            with open(raw, 'ab', buffering=0) as out:
                for cmd in commands:
                    deadline = time.monotonic() + wait_max
                    while True:
                        out.write(f'$ {cmd}\n'.encode())
                        code = run_group(cmd, work, run_env, timeout, out)
                        if code not in busy_codes or time.monotonic() >= deadline:
                            break
                        out.write(f'# код {code}: общий ресурс занят, повтор через {wait_poll} с; '
                                  f'ожидание в таймаут не входит\n'.encode())
                        on_state and on_state('waiting')
                        time.sleep(wait_poll)
                        on_state and on_state('running')
                    if code in busy_codes:
                        return finish('deferred', f'`{cmd}`: общий ресурс занят дольше {wait_max} с (код {code}), '
                                                  f'приёмка отложена', code=code)
                    if code is None:
                        return finish('failed', f'таймаут {timeout} с на `{cmd}`')
                    if code:
                        return finish('failed', f'`{cmd}` завершилась с кодом {code}', code=code)
            return finish('passed', 'зелёно', code=0)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)

    def merge(self, sha, branch, ref):
        """Влить ровно проверенный коммит, а не то, на что ветка указывает сейчас."""
        if self.git('symbolic-ref', '--short', 'HEAD').stdout.strip() != self.base:
            raise RuntimeError(f'{self.path} не на {self.base}')
        if self.git('status', '--porcelain', '--untracked-files=no').stdout.strip():
            raise RuntimeError(f'{self.path}: незакоммиченные изменения')
        self.git('merge', '--no-ff', sha, '-m', f"Merge branch '{branch}'. {ref}", check=True)


class Watch:
    """Состояние между тиками и журнал действий для страницы статуса."""

    def __init__(self, dry):
        self.dry = dry
        self.target_key = None
        self.publish_early = None  # колбэк _run: опубликовать строку эпика до долгой приёмки
        self.state = json.loads(STATE.read_text()) if STATE.exists() else {}
        self.saved = copy.deepcopy(self.state)

    def permit(self, settings=None):
        if settings is None:
            with control.Store().locked() as current:
                return self.permit(current)
        if settings.get('paused'):
            raise AutomationPaused('Конвейер на паузе')
        target = settings.get('targets', {}).get(self.target_key, {}) if self.target_key else {}
        if not target.get('enabled', True) or target.get('removed'):
            raise AutomationPaused(self.target_key + ' исключена из конвейера')
        if target.get('paused'):
            raise AutomationPaused(self.target_key + ' на паузе')

    def save(self):
        if self.dry:
            return
        # Each lane owns its keys; acceptance must not overwrite a newer provider pass.
        with control.Store(STATE).locked() as current:
            for key in self.saved.keys() | self.state.keys():
                if key == '_events':
                    continue
                if key not in self.state:
                    current.pop(key, None)
                elif key not in self.saved or self.state[key] != self.saved[key]:
                    current[key] = copy.deepcopy(self.state[key])
            previous_events = self.saved.get('_events', [])
            added = [e for e in self.state.get('_events', []) if e not in previous_events]
            if added:
                current['_events'] = sorted(current.get('_events', []) + added, key=lambda e: e['t'])[-EVENTS_KEEP:]
            self.state = copy.deepcopy(current)
        self.saved = copy.deepcopy(self.state)

    def log(self, kind, text):
        print(text)
        if self.dry:
            return
        ev = self.state.setdefault('_events', [])
        # ws — workspace события: журнал на странице «Конвейер» показывает только свой.
        ev.append({'t': now_utc().isoformat(timespec='seconds'), 'kind': kind, 'text': text, 'ws': getattr(self, 'ws', None)})
        del ev[:-EVENTS_KEEP]


def jobs_dir(): return STATE.parent / 'accept-jobs'


def job_path(key, sha, base_sha):
    """Одна пара «коммит задачи + коммит base» — один файл задачи приёмки: по нему повтор тика и перезапуск сторожа
    находят уже запущенную проверку, а новый коммит любой из сторон — это новая проверка."""
    return jobs_dir() / f'{re.sub(r"[^A-Za-z0-9._-]", "_", key)}-{sha[:12]}-{base_sha[:12]}.json'


def read_job(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None


def write_job(path, job):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f'.{path.name}.{os.getpid()}.tmp')
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(job, f, ensure_ascii=False, indent=1)
    tmp.replace(path)


@contextlib.contextmanager
def job_lock(path, wait=0.0):
    """Замок воркера задачи приёмки: держит его всё время проверки, ядро снимает его и при аварийном выходе.
    Свободный замок у незавершённой задачи значит, что воркера нет."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.with_suffix('.lock').open('a') as lock:
        deadline = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    yield False
                    return
                time.sleep(0.2)
        try:
            yield True
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def worker_alive(path):
    with job_lock(path) as free:
        return not free


def launch_job(path):
    """Отдать проверку atd. Юнит сторожа — oneshot: при выходе systemd убивает всех его потомков, а задача atd живёт
    вне юнита, поэтому тик её не ждёт, а выкладка и перезапуск сторожа её не прерывают. Возвращает номер задачи at.
    atd сохраняет окружение и каталог постановщика: без TMPDIR/TMP/TEMP и из каталога задач, иначе тик вручную
    из рана агента отдаёт проверке его /tmp/multica-task-…, который демон удаляет по концу рана."""
    out = path.with_suffix('.out')
    cmd = (f'exec {shlex.quote(sys.executable)} -I {shlex.quote(str(Path(__file__).resolve()))} --accept-job '
           f'{shlex.quote(str(path))} >>{shlex.quote(str(out))} 2>&1\n')
    env = {k: v for k, v in os.environ.items() if k not in ('TMPDIR', 'TMP', 'TEMP')}
    r = subprocess.run(['at', 'now'], input=cmd, capture_output=True, text=True, timeout=60, env=env,
                       cwd=str(path.parent))
    if r.returncode:
        raise RuntimeError(f'at now: {r.stderr.strip()[:300]}')
    m = re.search(r'\bjob (\d+)', r.stderr)
    return m.group(1) if m else ''


def start_job(path, job, now):
    """Записать задачу и отдать её atd. После запуска файл пишет только воркер: тик его не перетирает."""
    job.update(status='queued', queued_at=now.isoformat(), attempts=job.get('attempts', 0) + 1,
               reason=None, code=None, tail=None)
    write_job(path, job)
    print(f'{path.stem}: задача atd {launch_job(path) or "?"}')


def prune_jobs(directory, now=None):
    cutoff = (now or time.time()) - ACCEPT_LOG_KEEP_DAYS * 86400
    for f in directory.glob('*.json'):
        with contextlib.suppress(OSError, ValueError):
            if f.stat().st_mtime < cutoff and (read_job(f) or {}).get('status') not in JOB_ACTIVE:
                for p in (f, f.with_suffix('.lock'), f.with_suffix('.out')):
                    p.unlink(missing_ok=True)


def job_running(path, job, now):
    """Проверка идёт: воркер держит замок или at-задача ещё может стартовать."""
    if job.get('status') not in JOB_ACTIVE:
        return False
    return worker_alive(path) or (job['status'] == 'queued'
                                  and now - ts(job['queued_at']) < dt.timedelta(seconds=JOB_LOST_AFTER))


def refresh_job(path, job, now, retry_minutes):
    """Довести задачу приёмки до живого состояния. Воркер пропал (перезагрузка, OOM, at-задача не стартовала) —
    перезапуск той же задачи, не больше JOB_ATTEMPTS раз; отложенная — новая попытка через `retry_minutes`.
    Возвращает (задача, что сделано или None)."""
    st = job.get('status')
    if st in JOB_ACTIVE:
        if job_running(path, job, now):
            return job, None
        if job.get('attempts', 1) >= JOB_ATTEMPTS:
            job.update(status='failed', finished_at=now.isoformat(), code=None, tail='',
                       reason=f'проверка прерывалась {job.get("attempts", 1)} раза, воркер приёмки не доработал')
            write_job(path, job)
            return job, 'gave_up'
        start_job(path, job, now)
        return job, 'restarted'
    if st == 'deferred' and now - ts(job['finished_at']) >= dt.timedelta(minutes=retry_minutes):
        job['attempts'] = 0  # отложенная не прерывалась: счётчик потерь начинается заново
        start_job(path, job, now)
        return job, 'retried'
    return job, None


def run_job(path):
    """Воркер задачи приёмки (`--accept-job`): проверка одной пары коммитов, итог — в файл задачи. Побочные действия
    (слияние, комментарий, статус задачи) делает тик по этому итогу: у воркера нет Multica и паузы целей."""
    with job_lock(path, wait=JOB_LOCK_WAIT) as mine:
        job = read_job(path) if mine else None
        if not job or job.get('status') not in JOB_ACTIVE:
            return
        now = now_utc()

        def save(**fields):
            job.update(fields)
            write_job(path, job)

        try:
            cfg = json.loads(CONFIG.read_text())
            with control.Store().locked() as settings:
                epic = next((t for t in control.targets(cfg, settings) if t['key'] == job['epic']), None)
                if epic:
                    target = settings.get('targets', {}).get(job['epic'], {})
                    paused = settings.get('paused') or target.get('paused') or not target.get('enabled', True)
            if not epic or epic.get('repo') != job['repo']:
                return save(status='failed', finished_at=now.isoformat(), reason='эпик убран из конфига сторожа')
            if paused:
                return save(status='deferred', finished_at=now.isoformat(), reason='конвейер или эпик на паузе')
            save(status='running', started_at=now.isoformat(), pid=os.getpid())
            result = Repo(job['repo'], job['base']).accept(
                job['sha'], epic.get('acceptance', []), epic.get('acceptance_timeout', 1500), key=job['key'],
                path=epic.get('acceptance_path'), env={**ACCEPT_ENV_DEFAULTS, **(epic.get('acceptance_env') or {})},
                base_ref=job['base_sha'], label=job['branch'], busy_codes=tuple(epic.get('acceptance_busy_codes', BUSY_CODES)),
                wait_poll=epic.get('acceptance_wait_poll', 60), wait_max=epic.get('acceptance_wait_max', 7200),
                on_state=lambda s: save(status=s, **({'waiting_since': now_utc().isoformat()} if s == 'waiting' else {})))
            save(**result, finished_at=now_utc().isoformat())
        except Exception as e:
            save(status='failed', finished_at=now_utc().isoformat(), code=None, tail=traceback.format_exc()[-1500:],
                 reason=f'сбой проверки: {e}'[:300])


def owner_mention(epic, issue):
    """Кого будить по проблеме приёмки: агента-исполнителя задачи — он знает свою ветку и правку; задача на скваде
    или без исполнителя — лидера. Лишний переход через лидера стоил часов, когда тот стоял на лимите."""
    agent, lead = issue.get('assignee_id'), epic.get('lead_id')
    if issue.get('assignee_type') == 'agent' and agent and agent != lead:
        return f"[@исполнитель](mention://agent/{agent}), "
    return f"[@Тимлид](mention://agent/{lead}), " if lead else ''


def add_comment(m, key, body):
    """Комментарий через файл: тело может быть длинным и содержать markdown."""
    with tempfile.NamedTemporaryFile(mode='w', suffix='.md', encoding='utf-8') as content:
        content.write(body)
        content.flush()
        os.chmod(content.name, 0o644)
        m('issue', 'comment', 'add', key, '--content-file', content.name, '--allow-external-file', write=True)


def report_failure(m, epic, repo, issue, branch, why, tail):
    key = issue['identifier']
    cmds = ', '.join(f'`{c}`' for c in epic.get('acceptance', []))
    body = (f"{owner_mention(epic, issue)}автоприёмка конвейера не прошла: ветка `{branch}`, {why}. Приёмка — свежий "
            f"клон ветки поверх свежего `{repo.base}`, проверка диффа, затем {cmds}. Почини в той же ветке, запиши "
            f"новый полный SHA в metadata `commit` и верни задачу в `in_review` — конвейер примет и вольёт сам."
            f"\n\n```\n{tail.strip()[-2500:]}\n```")
    add_comment(m, key, body)
    m('issue', 'update', key, '--status', 'in_progress', write=True)


def report_accept_problem(m, epic, issue, w):
    """Запись в журнале не будит владельца. Доставить блокер отдельно и помнить успешную доставку
    между тиками; ошибка CLI не должна ни терять уведомление, ни останавливать приёмку остальных задач."""
    key, problem = issue['identifier'], issue.get('accept_problem')
    notified = w.state.setdefault('_accept_notified', {})
    if not problem:
        notified.pop(key, None)
        return
    if notified.get(key) == problem:
        return
    if issue.get('route_wait'):
        lead = epic.get('lead_id')
        body = (f"{f'[@Тимлид](mention://agent/{lead}), ' if lead else ''}{key} не вливается: {problem}.\n\n"
                "Сторож вливает в base только задачу, прошедшую review по маршруту (и QA, если он в маршруте). "
                "Допиши в `route` недостающий шаг и верни задачу на него — после `close` приёмка пойдёт сама.")
    else:
        body = None
    body = body or (f"{owner_mention(epic, issue)}приёмка {key} не началась: {problem}.\n\n"
            "Сверь итоговый отчёт, результаты QA/review и ветку исполнителя. Запиши в metadata задачи "
            "`branch` и `commit` — полный SHA из 40 символов именно сданного коммита. Ветка должна указывать "
            "на этот SHA. Если работа ещё не сдана, верни её на соответствующий шаг маршрута. "
            "Сторож не угадывает ветку по комментариям и не меняет статус из-за неполных метаданных. "
            "После исправления приёмка продолжится в следующем тике.")
    w.permit()
    try:
        add_comment(m, key, body)
    except (RuntimeError, subprocess.TimeoutExpired, OSError):
        # Не логировать сырой ответ CLI: он может содержать credentials.
        w.log('wait', f"{epic['key']}: {key} — уведомление о блокере приёмки не доставлено, повторим в следующем тике")
        return
    notified[key] = problem
    w.save()  # Следующая задача/тик не должны повторять уже доставленный комментарий.


def accept_issue(m, repo, epic, issue, w, now=None, start=True):
    """Приёмка задачи отдельной задачей atd и слияние по её итогу; тик проверку не ждёт. Нет задачи на эту пару
    коммитов — запустить (по одной на эпик за раз: слияние сдвигает base остальным); идёт — ждать; зелёная — влить
    ровно проверенный коммит; красная — один раз сообщить исполнителю (лидеру, если задача на скваде). True — задача влита."""
    key, branch, sha = issue['identifier'], issue['accept']['branch'], issue['accept']['sha']
    base_sha = repo.head(repo.base)
    pair = f'{sha}+{base_sha}'
    if already_failed(w.state, key, branch, pair):
        print(f"{epic['key']}: {key} {branch} уже не прошла приёмку на этих коммитах, ждём правки")
        issue['accept_job'] = {'status': 'failed', 'reason': 'не прошла на этих коммитах, ждём правки'}
        return False
    now = now or now_utc()
    path = job_path(key, sha, base_sha)
    job = read_job(path)
    if w.dry:
        print(f"{epic['key']}: {key} приёмка {branch}@{sha[:12]}: {job['status'] if job else 'будет запущена'}")
        return False
    prune_jobs(jobs_dir())
    if job is None and not start:
        return False
    if job is None:
        others = ((p, read_job(p) or {}) for p in jobs_dir().glob('*.json') if p != path)
        busy = [p for p, other in others if other.get('epic') == epic['key'] and job_running(p, other, now)]
        if busy:
            print(f"{epic['key']}: {key} ждёт очереди приёмки, идёт {busy[0].stem}")
            issue['accept_job'] = {'status': 'queued', 'reason': 'ждёт, пока закончится приёмка другой задачи эпика'}
            return False
        w.permit()
        job = {'epic': epic['key'], 'key': key, 'repo': epic['repo'], 'base': repo.base, 'branch': branch, 'sha': sha,
               'base_sha': base_sha}
        start_job(path, job, now)
        w.log('accept', f"{epic['key']}: {key} {branch}@{sha[:12]} — приёмка запущена отдельной задачей")
    else:
        job, change = refresh_job(path, job, now, epic.get('acceptance_retry_minutes', 10))
        if change == 'restarted':
            w.log('accept', f"{epic['key']}: {key} {branch}@{sha[:12]} — воркер приёмки пропал, перезапуск "
                            f"{job['attempts']} из {JOB_ATTEMPTS}")
        elif change == 'retried':
            w.log('accept', f"{epic['key']}: {key} {branch}@{sha[:12]} — новая попытка отложенной приёмки")
    issue['accept_job'] = {'status': job['status'], 'reason': job.get('reason')}
    if job['status'] == 'deferred' and not job.get('deferral_logged'):
        w.log('wait', f"{epic['key']}: {key} {branch}@{sha[:12]} — приёмка отложена: {job.get('reason')}")
        job['deferral_logged'] = True
        write_job(path, job)
    if job['status'] == 'failed' and not job.get('reported'):
        w.state.setdefault(key, {})[branch] = pair
        w.log('fail', f"{epic['key']}: {key} {branch}@{sha[:12]} не прошла приёмку: {job.get('reason')}")
        w.save()
        report_failure(m, epic, repo, issue, branch, job.get('reason') or 'провал', job.get('tail') or '')
        job['reported'] = True
        write_job(path, job)
    if job['status'] != 'passed':
        return False
    w.permit()
    # Проверка шла минуты: за это время задачу могли вернуть по маршруту, сменить коммит или отменить.
    fresh = m('issue', 'get', key)
    fresh = fresh.get('issue', fresh)
    meta = fresh.get('metadata') or {}
    why = ('задача отменена' if is_cancelled(fresh) else
           'в metadata уже другой branch/commit' if (str(meta.get('branch') or '').strip() != branch or
                                                     str(meta.get('commit') or '').strip().lower() != sha) else
           route_gate(fresh))
    if why:
        problems = w.state.setdefault('_accept_problems', {})
        if problems.get(key) != why:
            problems[key] = why
            w.log('wait', f"{epic['key']}: {key} {branch}@{sha[:12]} проверена, но не влита: {why}")
        issue['accept_job'] = {'status': 'blocked', 'reason': why}
        return False
    repo.merge(sha, branch, epic.get('commit_ref', key))
    w.log('merge', f"{epic['key']}: {key} {branch}@{sha[:12]} принята и влита в {repo.base}")
    if not is_done(issue):
        m('issue', 'update', key, '--status', 'done', write=True)
    issue['unmerged'] = []
    issue['status'] = 'done'
    return True


VERDICTS = ('pass', 'fail', 'blocked')
ROUND_LIMIT = 3  # третий возврат подряд — уже не правка, а вопрос к лидеру и человеку


def parse_route(text):
    return [tuple(x.strip() for x in pair.split(':', 1)) for pair in (text or '').split(',') if ':' in pair]


def route_move(meta):
    """Итог шага → (имя, кого упомянуть; что ему сказать; ключи metadata; новый статус или None)."""
    route = parse_route(meta.get('route'))
    lead = route[-1][1] if route and route[-1][0] == 'close' else None
    # pos различает две пары одного шага (dev:Бэкенд,dev:Фронтенд); `step`, переписанный лидером вручную, главнее.
    pos = int(meta['pos']) if str(meta.get('pos', '')).isdigit() else None
    if pos is None or pos >= len(route) or route[pos][0] != meta.get('step'):
        pos = next((i for i, (step, _) in enumerate(route) if step == meta.get('step')), None)
    if pos is None:
        return lead, f"маршрут не разобран (step `{meta.get('step')}`, route `{meta.get('route')}`)", {}, None
    step, verdict = route[pos][0], meta.get('verdict')
    if verdict == 'pass':
        nxt = pos + 1
        if nxt >= len(route) or route[nxt][0] == 'close':
            return lead, 'шаг close: маршрут пройден, задача в `in_review`', {'step': 'close', 'pos': min(nxt, len(route) - 1)}, 'in_review'
        return route[nxt][1], f'шаг {route[nxt][0]}: отчёт предыдущего шага выше', {'step': route[nxt][0], 'pos': nxt}, None
    if verdict == 'fail':
        dev = next((i for i in range(pos - 1, -1, -1) if route[i][0] == 'dev'), None)
        n = int(meta.get('round') or 0) + 1
        if dev is None:
            return lead, f'шаг {step} не пройден, а исполнителя `dev` до него в маршруте нет', {}, None
        if n >= ROUND_LIMIT:
            return lead, f'круг {n}: шаг {step} не пройден снова — нужен человек', {'round': n}, None
        return route[dev][1], f'возврат, круг {n}: исправь замечания из отчёта выше и сдай шаг dev', \
            {'step': 'dev', 'pos': dev, 'round': n}, None
    return lead, f'шаг {step} остановлен: вопрос или блокер в отчёте выше', {}, None


def advance_route(m, w, issue, agents):
    """Передать задачу по итогу шага. Упоминание — первым: не доставлено — `verdict` остаётся, повторим в тике."""
    key, meta = issue['identifier'], issue.get('metadata') or {}
    verdict = meta.get('verdict')
    if not is_done(issue) and not is_cancelled(issue):
        who, text, keys, status_to = route_move(meta)
        mention = f'[@{who}](mention://agent/{agents[who]}) — ' if who in agents else (f'(«{who}» нет среди агентов) ' if who else '')
        ref = ''.join(f' {k.capitalize()} `{meta[k]}`.' for k in ('branch', 'commit') if meta.get(k))
        w.permit()
        add_comment(m, key, f'{mention}{text}.{ref}')
        if status_to:
            m('issue', 'update', key, '--status', status_to, write=True)
        for k, v in keys.items():
            m('issue', 'metadata', 'set', key, '--key', k, '--value', str(v), write=True)
        w.log('route', f'{key}: {verdict} → {who or "никто"}: {text}')
    m('issue', 'metadata', 'delete', key, '--key', 'verdict', write=True)


FAILURE_GRACE = dt.timedelta(minutes=5)  # платформа успевает поставить свой повтор
FAILURES_KEEP = dt.timedelta(days=7)


def report_route_failures(m, w, a, entry, runs, now, agent_ids):
    """Окончательное падение рана в задаче с `route`, которое никто не подхватит, — один раз лидеру маршрута.
    Лимит и инфраструктуру повторяет сторож; ран, запущенный раном агента, Multica сама возвращает координатору."""
    seen = entry.setdefault('failures_reported', {})
    since = ts(entry.setdefault('failures_since', now.isoformat()))  # историю до включения не разбираем
    for r in runs:
        done_at = ts(r.get('completed_at'))
        if (r.get('status') != 'failed' or r['id'] in seen or not r.get('issue_id') or not done_at or done_at < since
                or now - done_at < FAILURE_GRACE or is_quota_failure(r) or is_infra_failure(r)
                or (r.get('attribution') or {}).get('delegated_from_task_id')):
            continue
        if any(o.get('issue_id') == r['issue_id'] and (o.get('created_at') or '') > r['created_at'] for o in runs):
            seen[r['id']] = now.isoformat()  # уже повторили
            continue
        issue = m('issue', 'get', r['issue_id'])
        issue = issue.get('issue', issue)
        meta = issue.get('metadata') or {}
        route = parse_route(meta.get('route'))
        lead = route[-1][1] if route and route[-1][0] == 'close' else None
        ids = agent_ids() if lead else {}
        if lead not in ids or lead == a['name'] or is_done(issue) or is_cancelled(issue):
            seen[r['id']] = now.isoformat()
            continue
        why = (r.get('error') or r.get('failure_reason') or 'без текста ошибки').strip()[:300]
        add_comment(m, issue['identifier'], f"[@{lead}](mention://agent/{ids[lead]}) — ран {a['name']} на шаге "
                    f"`{meta.get('step')}` упал, повтора не будет: {why}. Реши: повторить (`multica issue rerun`), "
                    "передать другому или позвать человека.")
        seen[r['id']] = now.isoformat()  # после доставки: ошибка CLI — повтор в следующем проходе
        w.log('fail', f"{issue['identifier']}: ран {a['name']} упал ({r.get('failure_reason') or 'ошибка'}) — сообщено {lead}")
    for rid in [k for k, v in seen.items() if now - ts(v) > FAILURES_KEEP]:
        del seen[rid]


def run_routes(w, workspaces):
    for ws in sorted(workspaces):
        m = Multica(ws, w.dry, w.permit)
        found = [i for v in VERDICTS for i in items(m('issue', 'list', '--metadata', f'verdict={v}', '--limit', '100'), 'issues')]
        if not found:
            continue
        agents = {a['name']: a['id'] for a in items(m('agent', 'list'), 'agents') if not a.get('archived_at')}
        for issue in found:
            try:
                advance_route(m, w, issue, agents)
            except (RuntimeError, subprocess.TimeoutExpired, OSError) as e:
                w.log('error', f"{issue['identifier']}: маршрут не передан, повторим в следующем тике: {str(e)[:200]}")


def snap_issue(i, staged=True):
    """Задача на странице; `accept` — состояние приёмки или причина, по которой её нет."""
    problem = i.get('accept_problem') or i.get('route_wait')
    acc = i.get('accept_job') or ({'status': 'blocked', 'reason': problem} if problem else None)
    return {'key': i['identifier'], 'title': i.get('title', ''), 'status': status(i), 'assigned': bool(i.get('assignee_id')),
            'held': staged and HOLD in (i.get('description') or ''), 'unmerged': i.get('unmerged') or [], 'jobs': [],
            'accept': acc}


def epic_entry(epic, stages, unstaged, stage, frozen, snap_issues):
    """Строка эпика для снимка страницы; джобы задач заполняет вызывающий в snap_issues."""
    return {'key': epic['key'], 'name': epic.get('name', epic['key']), 'stage': stage,
            'kind': epic.get('kind', 'epic'), 'paused': frozen,
            'stages': [{'stage': st['stage'], 'issues': [snap_issues.setdefault(i['identifier'], snap_issue(i))
                                                         for i in st['issues']]}
                       for st in sorted(stages, key=lambda s: s['stage'])],
            # Подзадачи без этапа сторож не назначает, но принимает, и на странице они видны.
            'unstaged': [snap_issue(i, staged=False) for i in unstaged]}


def dispatch_issue(m, epic, stage, issue, w, now):
    """Назначить задачу скваду, если по ней никто не работает. Список детей читается в начале тика, а приёмка
    идёт до 25 минут — поэтому перед записью задача и её раны перечитываются. Блокирует только сама задача:
    раны и будильники соседних задач эпика не мешают.
    Журнал намерения `_dispatch` привязан к ревизии задачи: назначение видно — запись снимается; ревизия
    сменилась, а исполнителя нет — задачу вернули, назначаем заново; ревизия та же — исход прошлой записи
    неизвестен, ждём DISPATCH_SETTLE_MINUTES и только потом повторяем."""
    key = issue['identifier']
    fresh = m('issue', 'get', key)
    fresh = fresh.get('issue', fresh)
    journal = w.state.setdefault('_dispatch', {})
    intent = journal.get(key)
    if fresh.get('assignee_id') or closed(fresh) or HOLD in (fresh.get('description') or ''):
        if intent and not w.dry:
            journal.pop(key)
        return
    if intent and intent.get('revision') == fresh.get('revision') and \
            now - ts(intent['at']) < dt.timedelta(minutes=DISPATCH_SETTLE_MINUTES):
        print(f"{epic['key']}: {key} назначение отправлено в {intent['at'][11:16]}, сервер его ещё не показал — ждём")
        return
    runs = items(m('issue', 'runs', key), 'runs')
    if any(r.get('status') in ACTIVE_RUN for r in runs):
        print(f"{epic['key']}: {key} без исполнителя, но по ней идёт ран — не назначаю")
        return
    w.log('assign', f"{epic['key']}: стадия {stage}, {key} → сквад")
    if w.dry:
        return
    w.permit()
    journal[key] = {'revision': fresh.get('revision'), 'at': now.isoformat()}
    w.save()
    # Статус и исполнитель — две записи: у `issue update --assignee-id` старт рана не проверен, а у `assign`
    # он штатный. Сорвётся вторая — ревизия уже сменилась, следующий тик назначит без ожидания.
    if status(fresh) in ('backlog', None):
        m('issue', 'update', key, '--status', 'todo', write=True)
    m('issue', 'assign', key, '--to-id', epic['squad_id'], write=True)


def run_epic(epic, w, snapshot, frozen=False):
    """frozen — цель на паузе: только читаем для снимка, ничего не назначаем, не повторяем и не сливаем."""
    m = Multica(epic['workspace'], w.dry, w.permit)
    if epic.get('kind') == 'issue':
        root = m('issue', 'get', epic['key'])
        stages = [{'stage': 1, 'issues': [root.get('issue', root)]}]
        unstaged = []
    else:
        children = m('issue', 'children', epic['key'])
        stages = children.get('stages', [])
        unstaged = children.get('unstaged', [])
    repo = Repo(epic['repo'], epic.get('base', 'main')) if epic.get('repo') else None
    if repo:
        # Приёмка не зависит от этапа: любая подзадача на сдаче, в том числе без этапа.
        every = [i for st in stages for i in st['issues']] + unstaged
        mark_unmerged(every, lambda i: accept_target(i, repo))
        for i in every:
            # Причина, по которой задачу на сдаче нельзя принять, — в журнал один раз, пока она не сменится.
            if frozen or w.dry:
                continue
            problems = w.state.setdefault('_accept_problems', {})
            reason = i.get('accept_problem') or i.get('route_wait')
            if reason and problems.get(i['identifier']) != reason:
                problems[i['identifier']] = reason
                w.log('wait', f"{epic['key']}: {i['identifier']} не принимается: {reason}")
            elif not reason:
                problems.pop(i['identifier'], None)
            report_accept_problem(m, epic, i, w)
        to_accept = [] if frozen else [i for i in every if i.get('unmerged') and not i.get('route_wait')]
        if to_accept and w.publish_early:
            w.publish_early(epic_entry(epic, stages, unstaged, decide(stages)[0], frozen, {}))
        # Сначала влить готовые, потом запускать новые: слияние сдвигает base, и проверка, начатая до него,
        # шла бы на старом base и повторилась бы целиком.
        merged = set()
        for start in (False, True):
            for issue in to_accept:
                if issue['identifier'] not in merged and accept_issue(m, repo, epic, issue, w, start=start):
                    merged.add(issue['identifier'])
    stage, _, to_assign, held = decide(stages)
    to_assign = to_assign[:epic.get('max_per_tick', 4)]
    overrides = [] if frozen else epic.get('overrides', [])
    levels = {}
    for agent_id in {o['agent_id'] for o in overrides}:
        a = m('agent', 'get', agent_id)
        levels[agent_id] = a.get('agent', a).get('thinking_level')
    for agent_id, level in override_levels(stages, overrides, {i['identifier'] for i in to_assign}, levels):
        w.log('level', f"{epic['key']}: агент {agent_id[:8]} → уровень {level}")
        m('agent', 'update', agent_id, '--thinking-level', level, write=True)
    snap_issues = {}
    snapshot['epics'].append(epic_entry(epic, stages, unstaged, stage, frozen, snap_issues))
    if stage is None:
        return
    for issue in held:
        print(f"{epic['key']}: стадия {stage}, {issue['identifier']} ждёт заказчика")
    active = next(st for st in stages if st['stage'] == stage)
    now = now_utc()
    infra = w.state.setdefault('_infra_retry', {})
    infra_minutes = epic.get('infra_retry_minutes', epic.get('quota_retry_minutes', 20))
    names = snapshot.get('agent_names', {})
    for issue in active['issues']:
        key = issue['identifier']
        if not issue.get('assignee_id') or issue in held:
            continue
        runs = items(m('issue', 'runs', key), 'runs')
        snap_issues[key]['jobs'] = jobs_of(runs, names)
        if frozen or closed(issue) or issue.get('unmerged'):
            continue
        last = latest(runs)
        if last and last.get('status') not in ACTIVE_RUN and not is_infra_failure(last):
            # Другой исход завершает последовательность; стартовавший повтор ещё не имеет исхода.
            if not w.dry:
                infra.pop(key, None)
        # Повтор после лимита провайдера — только в полосе провайдеров; здесь — инфраструктурные падения.
        if infra_retry(runs, now, infra.get(key), infra_minutes, epic.get('infra_retry_limit', 3)):
            # The provider lane uses this same lock for read/check/rerun.
            with control.Store().locked() as settings:
                w.permit(settings)
                locked_m = Multica(epic['workspace'], w.dry, lambda: w.permit(settings))
                fresh = locked_m('issue', 'get', key)
                fresh = fresh.get('issue', fresh)
                runs = items(locked_m('issue', 'runs', key), 'runs')
                if closed(fresh) or status(fresh) == 'in_review':
                    continue
                last = latest(runs)
                if not last or not is_infra_failure(last):
                    if last and last.get('status') not in ACTIVE_RUN and not w.dry:
                        infra.pop(key, None)
                    continue
                mem = infra.get(key, {})
                action = infra_retry(runs, now, mem, infra_minutes, epic.get('infra_retry_limit', 3))
                if action == 'retry':
                    # Не пишем сырой текст ошибки рана: он может содержать credentials.
                    w.log('retry', f"{epic['key']}: {key} — ран упал на инфраструктуре, повтор")
                    locked_m('issue', 'rerun', key, write=True)
                    if not w.dry:
                        infra[key] = {'at': now.isoformat(), 'n': mem.get('n', 0) + 1}
                elif action == 'give_up' and not mem.get('gave_up'):
                    w.log('fail', f"{epic['key']}: {key} — {mem.get('n', 0)} повтора подряд упали на инфраструктуре, жду человека")
                    if not w.dry:
                        infra[key] = {**mem, 'gave_up': True}
    if not frozen and not w.dry:
        journal = w.state.setdefault('_dispatch', {})
        for i in [i for st in stages for i in st['issues']] + unstaged:
            if i['identifier'] in journal and (i.get('assignee_id') or closed(i)):
                del journal[i['identifier']]
    for issue in [] if frozen else to_assign:
        dispatch_issue(m, epic, stage, issue, w, now)


def apply_profile(m, agent_id, p):
    args = ['agent', 'update', agent_id, '--runtime-id', p['runtime_id'], '--model', p.get('model', ''),
            '--thinking-level', p.get('thinking_level', ''), '--custom-args', json.dumps(p.get('custom_args', []), ensure_ascii=False)]
    m(*args, write=True)


def run_providers(cfg, w, snapshot):
    # Общий lock с пультом закрывает гонку «прочитал auto → пользователь выбрал вручную → перезаписал».
    with control.Store().locked() as settings:
        if cfg.get('subscriptions'):
            control.export_subscriptions(cfg, settings)
        if settings.get('paused'):
            return
        _run_providers(cfg, w, snapshot, settings)


def _run_providers(cfg, w, snapshot, settings):
    pc = cfg.get('providers')
    if not pc:
        return
    clients = {}
    names = control.runtime_names(cfg, settings)
    now = now_utc()
    avail = control.availability(cfg, names)
    rows = control.quota_rows(cfg)
    restore_hours, retry_minutes = pc.get('restore_hours', 5), pc.get('quota_retry_minutes', 20)
    st = w.state.setdefault('_providers', {})
    leaders = {}  # сквад → лидер, на один проход
    names_by_ws = {}  # workspace → {имя агента: id}, лениво и на один проход
    # Цепочки из конфига и сохранённые на экране агента в Multica.
    for agent_id, a in control.agent_chains(cfg, settings).items():
        chain = a['chain']
        ws = a.get('workspace') or pc['workspace']
        w.ws = ws
        m = clients.setdefault(ws, Multica(ws, w.dry))
        entry = st.setdefault(agent_id, {'idx': 0, 'since': None})
        actual = m('agent', 'get', agent_id)
        actual = actual.get('agent', actual)
        matched = next((i for i, p in enumerate(chain) if p['runtime_id'] == actual.get('runtime_id')
                        and (p.get('model') or '') == (actual.get('model') or '')), None)
        if matched is not None and matched != entry.get('idx'):
            entry.update(idx=matched, since=now.isoformat())
        chosen = settings.get('agents', {}).get(agent_id, {})
        mode = chosen.get('mode', 'auto')
        if matched is None:
            # Внешний профиль не угадываем и автоматически не перетираем.
            mode = 'manual'
        runs = items(m('agent', 'tasks', agent_id, '--limit', '30'), 'tasks')
        last = latest(runs) or {}
        if a.get('pending_apply'):
            # Новая цепочка с экрана агента: ставим её, когда у агента ничего не идёт — идущий ран не трогаем,
            # очередь не ждём (у лидера она не пустеет): раны из неё переедут на новый runtime ниже.
            if any(r.get('status') in RUNNING for r in runs):
                continue
            start = control.next_profile([avail.get(p['runtime_id']) for p in chain], 0) or 0
            p = chain[start]
            w.log('provider', f"{a['name']}: новая цепочка, работает на "
                              f"{names.get(p['runtime_id'], p['runtime_id'][:8])} {p.get('model') or ''}".rstrip())
            apply_profile(m, agent_id, p)
            if not w.dry:
                settings['chains'][agent_id]['pending_apply'] = False
                entry.update(idx=start, since=now.isoformat(), waiting=None)
                settings.setdefault('agents', {}).pop(agent_id, None)
                actual = p
            matched, mode = start, 'auto'
        # Остывание — по runtime, а не по номеру в цепочке: цепочку меняют с экрана, а повтор multica
        # падает на старом runtime уже после переезда. Старый формат (номер → время) отбрасываем.
        cooldowns = {k: v for k, v in (entry.get('cooldowns') or {}).items() if isinstance(v, dict)}
        entry['cooldowns'] = cooldowns
        if mode == 'auto' and last and is_quota_failure(last) and entry.get('failure_seen') != last.get('id') \
                and ts(last.get('created_at')) and now - ts(last['created_at']) < dt.timedelta(hours=restore_hours):
            rid = last.get('runtime_id') or chain[min(entry.get('idx', 0), len(chain) - 1)]['runtime_id']
            name = names.get(rid, rid[:8])
            until, streak = cooldown_until(last, now, avail.get(rid), control.reset_at(name, rows, now), restore_hours,
                                           cooldowns.get(rid), retry_minutes)
            cooldowns[rid] = {'until': until.isoformat(), 'n': streak}
            entry['failure_seen'] = last.get('id')
            w.log('provider', f"{a['name']}: {name} на лимите, не берём до {until.astimezone(control.MSK):%d.%m %H:%M} МСК")
        cooling = {rid for rid, c in cooldowns.items() if ts(c.get('until')) and ts(c['until']) > now}
        statuses = [False if p['runtime_id'] in cooling else avail.get(p['runtime_id']) for p in chain]
        # Раны в очереди на прежнем runtime multica не выдаст — это не работа агента, ждать их нечего.
        live = [r for r in runs if not is_stale(r, actual.get('runtime_id'))]
        waiting = entry.get('waiting')
        if waiting and mode == 'auto' and not any(r.get('status') in control.ACTIVE for r in live):
            # Будильник: вся цепочка была на лимите. Слабее порога не подставляем — ждём сброса и будим сами.
            ready = next((i for i, x in enumerate(statuses) if x is True), None)
            if ready is None and now >= ts(waiting['wake_at']):
                ready = waiting.get('idx', entry.get('idx', 0))
            if ready is not None:
                p = chain[ready]
                w.log('provider', f"{a['name']}: будильник — квота сброшена, работает на "
                                  f"{names.get(p['runtime_id'], p['runtime_id'][:8])} {p.get('model') or ''}".rstrip())
                if ready != entry.get('idx') or matched is None or actual.get('runtime_id') != p['runtime_id']:
                    apply_profile(m, agent_id, p)
                    if not w.dry:
                        actual = p
                if not w.dry:
                    entry.update(idx=ready, since=now.isoformat(), waiting=None)
        elif not waiting or mode != 'auto':
            decision = provider_decision(live, entry, len(chain), now, restore_hours, mode, statuses,
                                         pc.get('restore_minutes', 30), actual.get('runtime_id'))
            if decision and decision[0] in ('switch', 'restore'):
                idx = decision[1]
                p = chain[idx]
                verb = 'лимит или недоступный профиль, переезжает на' if decision[0] == 'switch' else 'возвращается на'
                w.log('provider', f"{a['name']}: {verb} {names.get(p['runtime_id'], p['runtime_id'][:8])} {p.get('model') or ''}".rstrip())
                apply_profile(m, agent_id, p)
                if not w.dry:
                    entry.update(idx=idx, since=now.isoformat())
                    actual = p
            elif decision and decision[0] == 'exhausted' and entry.get('exhausted_logged') != last.get('id'):
                wake_idx, wake = wake_target(chain, names, cfg, now, retry_minutes, cooldowns)
                w.log('fail', f"{a['name']}: вся цепочка на лимите, ждёт сброса — будильник на "
                              f"{wake.astimezone(control.MSK):%d.%m %H:%M} МСК")
                if not w.dry:
                    entry['exhausted_logged'] = last.get('id')
                    entry['waiting'] = {'since': now.isoformat(), 'wake_at': wake.isoformat(), 'idx': wake_idx}
        record_quota_failures(entry, runs, now)
        if not w.dry:
            agent_ids = lambda m=m, ws=ws: names_by_ws.setdefault(ws, {
                x['name']: x['id'] for x in items(m('agent', 'list'), 'agents') if not x.get('archived_at')})
            try:
                report_route_failures(m, w, a, entry, runs, now, agent_ids)
            except (RuntimeError, subprocess.TimeoutExpired, OSError) as e:
                w.log('error', f"{a['name']}: падение рана не сообщено, повторим в следующем проходе: {str(e)[:200]}")
        rid = actual.get('runtime_id')
        # Повтор — когда профиль агента снова можно брать: после переезда, возврата или будильника, а не в остывающий
        # runtime. Ручной режим и ожидание сброса всей цепочки повторов не делают.
        if mode == 'auto' and not entry.get('waiting') and rid not in cooling and avail.get(rid) is not False:
            retry_quota_failed(m, w, a, agent_id, entry, now, leaders)
        move_stale_queued(m, w, a, agent_id, runs, actual.get('runtime_id'))
        snapshot['agents'].append({'name': a['name'], 'idx': entry.get('idx', 0), 'chain_len': len(chain),
                                   'runtime': names.get(actual.get('runtime_id'), actual.get('runtime_id', '—')),
                                   'model': actual.get('model') or '—', 'since': entry.get('since'), 'mode': mode,
                                   'waiting_until': (entry.get('waiting') or {}).get('wake_at'),
                                   'last_status': last.get('status'), 'last_at': last.get('created_at')})


def wake_target(chain, names, cfg, now, fallback_minutes, cooldowns=None):
    """Профиль цепочки, чья подписка освободится раньше всех, и когда: по сбросу окон дашборда и остыванию runtime
    после лимита (берём позднее из двух). Ни того, ни другого — через fallback_minutes."""
    rows = control.quota_rows(cfg)
    best = None
    for i, p in enumerate(chain):
        at = control.reset_at(names.get(p['runtime_id'], ''), rows, now)
        cool = ts(((cooldowns or {}).get(p['runtime_id']) or {}).get('until'))
        if cool and cool > now:
            at = max(at, cool) if at else cool
        if at and (best is None or at < best[1]):
            best = (i, max(at, now))
    return best or (0, now + dt.timedelta(minutes=fallback_minutes))


def move_stale_queued(m, w, a, agent_id, runs, runtime_id):
    """Раны агента в очереди на прежнем runtime снять и перезапустить задачу на текущем. Перезапуск — только
    своей задачи: назначенной агенту или, для рана лидера, его скваду; иначе `issue rerun` разбудит другого."""
    stale = [r for r in runs if is_stale(r, runtime_id)]
    done = set()
    for r in stale:
        w.log('provider', f"{a['name']}: ран {r['id'][:8]} в очереди на прежнем runtime — снят")
        m('issue', 'cancel-task', r['id'], write=True)
        iid = r.get('issue_id')
        if not iid or iid in done or any(x.get('issue_id') == iid and x.get('status') in control.ACTIVE
                                         and not is_stale(x, runtime_id) for x in runs):
            continue
        done.add(iid)
        issue = m('issue', 'get', iid)
        issue = issue.get('issue', issue)
        own = issue.get('assignee_id') == agent_id or (r.get('is_leader_task') and issue.get('assignee_type') == 'squad')
        if own and not (is_done(issue) or is_cancelled(issue)):
            w.log('retry', f"{a['name']}: задача {issue.get('identifier') or iid[:8]} перезапущена на новом runtime")
            m('issue', 'rerun', iid, write=True)


def record_quota_failures(entry, runs, now):
    """Учёт упавших на лимите ранов агента: каждый — в `quota_pending` до повтора или отказа от него.
    Учёт начинается с момента включения (`quota_since`): раны до него этот код не видел и задним числом не трогает."""
    since = ts(entry.setdefault('quota_since', (now - dt.timedelta(minutes=10)).isoformat()))
    pending = entry.setdefault('quota_pending', {})
    keep = dt.timedelta(days=QUOTA_RETRY_KEEP_DAYS)
    for r in runs:
        created = ts(r.get('created_at'))
        if is_quota_failure(r) and r.get('issue_id') and r.get('id') and r['id'] not in pending and created \
                and created >= since and now - created < keep:
            pending[r['id']] = {'issue': r['issue_id'], 'at': r['created_at']}
    for rid in [k for k, p in pending.items() if now - ts(p['at']) >= keep]:
        del pending[rid]


def retry_quota_failed(m, w, a, agent_id, entry, now, leaders):
    """Повторить каждый учтённый и ещё не повторённый ран агента, упавший на лимите, ровно один раз
    (что делать — quota_retry_plan). Перед решением задача и её раны перечитываются."""
    for rid, p in sorted(entry.get('quota_pending', {}).items(), key=lambda x: x[1]['at']):
        if p.get('done'):
            continue
        try:
            issue_runs = items(m('issue', 'runs', p['issue']), 'runs')
            issue = m('issue', 'get', p['issue'])
            issue = issue.get('issue', issue)
            run = next((r for r in issue_runs if r.get('id') == rid), None)
            squad = issue.get('assignee_id') if issue.get('assignee_type') == 'squad' else None
            if squad and squad not in leaders:
                leaders[squad] = m('squad', 'get', squad).get('leader_id')
            what, why = quota_retry_plan(run, issue_runs, issue, leaders.get(squad)) if run else ('drop', 'ран не найден')
            if what == 'wait':
                continue
            name = issue.get('identifier') or p['issue'][:8]
            out = {}
            if what == 'rerun':
                w.log('retry', f"{a['name']}: перезапуск задачи {name} после лимита")
                m('issue', 'rerun', p['issue'], write=True)
            elif what == 'wakeup':
                trigger = run.get('trigger_comment_id')
                w.log('retry', f"{a['name']}: будильник по задаче {name} после лимита — поручение агенту")
                args = ['issue', 'wakeup', 'create', p['issue'], '--kind', 'at', '--after', '1m', '--agent-id', agent_id,
                        '--mode', 'once', '--instruction',
                        RETRY_WAKE.format(trigger=f' из комментария {trigger}' if trigger else '')]
                out = m(*args, *(['--parent', trigger] if trigger else []), write=True) or {}
            else:
                print(f"{a['name']}: {name} — повтор после лимита не нужен: {why}")
        except RuntimeError as e:
            # Сбой чтения или записи Multica — попробуем на следующем проходе; ран остаётся в учёте.
            print(f"{a['name']}: повтор рана {rid[:8]} отложен: {e}")
            continue
        if not w.dry:
            p.update(done=now.isoformat(), how=what, why=why, **({'wakeup': out['id']} if out.get('id') else {}))


def needs_seed(status):
    """Справочники стенда ни разу не загружались и загрузка сейчас не идёт — свежая база после пересборки."""
    rows = status.get('items', [])
    if not rows:
        return True
    return any(r.get('lastSuccessAt') is None and (r.get('lastRun') or {}).get('status') not in ('running', 'queued', 'pending')
               for r in rows)


class Stand:
    """HTTP-клиент стенда сервиса: тестовый вход оператором (cookie + CSRF), переиспользует сессию между тиками."""

    def __init__(self, url, principal, saved):
        self.url, self.principal, self.saved = url.rstrip('/'), principal, saved

    def call(self, method, path, body=None):
        headers = {'Origin': self.url, 'Accept': 'application/json'}
        if body is not None:
            headers['Content-Type'] = 'application/json'
        if self.saved.get('cookie'):
            headers['Cookie'] = 'resource_session=' + self.saved['cookie']
            headers['x-csrf-token'] = self.saved.get('csrf', '')
        req = urllib.request.Request(self.url + path, data=None if body is None else json.dumps(body).encode(), headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.status, parse_json(r.read().decode() or '{}'), r.headers.get_all('Set-Cookie') or []
        except urllib.error.HTTPError as e:
            return e.code, {}, []

    def login(self):
        self.saved.clear()
        code, data, cookies = self.call('POST', '/auth/test/login', {'principalId': self.principal})
        if code != 200:
            raise RuntimeError(f'тестовый вход оператором: HTTP {code}')
        for c in cookies:
            m = re.match(r'resource_session=([^;]+)', c)
            if m:
                self.saved['cookie'] = m.group(1)
        self.saved['csrf'] = data.get('csrfToken', '')

    def authed(self, method, path, body=None):
        code, data, _ = self.call(method, path, body)
        if code in (401, 403):
            self.login()
            code, data, _ = self.call(method, path, body)
        return code, data


def run_stands(cfg, w, snapshot):
    for s in cfg.get('stands', []):
        saved = w.state.setdefault('_stands', {}).setdefault(s['name'], {})
        st = Stand(s['url'], s['operator_principal'], saved)
        code, status = st.authed('GET', '/api/v1/sync/status')
        if code != 200:
            snapshot['stands'].append({'name': s['name'], 'url': s['url'], 'line': f'статус справочников недоступен: HTTP {code}'})
            continue
        if needs_seed(status):
            w.log('stand', f"стенд {s['name']}: справочники пустые после пересборки — загружаю ({', '.join(s.get('sources', ['sphere']))})")
            if not w.dry:
                for source in s.get('sources', ['sphere']):
                    w.permit()
                    code, _ = st.authed('POST', f'/api/v1/sync/{source}', {})
                    if code not in (200, 202):
                        w.log('error', f"стенд {s['name']}: загрузка {source} — HTTP {code}")
        row = (status.get('items') or [{}])[0]
        counts = row.get('counts') or {}
        snapshot['stands'].append({'name': s['name'], 'url': s['url'], 'line':
                                   f"справочники: {counts.get('employees', 0)} сотр., {counts.get('projects', 0)} проектов, "
                                   f"обновлены {(row.get('lastSuccessAt') or 'никогда')[:16].replace('T', ' ')}"})


def quotas(cfg):
    """Загрузка подписок: окна из data.json дашборда usage-dash и последний выбор аккаунта обёрток."""
    out = []
    try:
        for row in json.loads(Path(cfg['usage_json']).read_text()).get('rows', []) if cfg.get('usage_json') else []:
            wins = ', '.join(f"{w['label']} {w['used']:.0f}%" + (f" (сброс {w['reset']})" if w.get('reset') else '')
                             for w in row.get('windows', []) if w.get('used') is not None)
            out.append({'name': row.get('name', ''), 'line': wins or row.get('error') or 'нет данных'})
    except (OSError, ValueError, KeyError, TypeError):
        out.append({'name': 'usage-dash', 'line': 'нет данных'})
    for name, path in cfg.get('quota_logs', {}).items():
        try:
            out.append({'name': name, 'line': Path(path).read_text().strip().splitlines()[-1]})
        except (OSError, IndexError):
            out.append({'name': name, 'line': 'нет данных'})
    return out


