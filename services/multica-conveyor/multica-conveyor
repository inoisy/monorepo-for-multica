            f"{' · активный этап ' + str(ep['stage']) if ep['stage'] else ''}</span></div>"
            f"<div class='pipe'>{cols}</div>"
            + (f"<h2 style='margin-top:12px'>Джобы активного этапа</h2>{detail}" if detail else '') + "</div>")
    if snapshot['agents']:
        rows = ''.join(
            f"<tr><td>{icon(job_state({'status': a['last_status']}))} {e(a['name'])}</td><td>{e(a['runtime'])}</td><td>{e(a['model'])}</td>"
            f"<td>{'основной' if a['idx'] == 0 else '<b>запасной ' + str(a['idx']) + '</b> с ' + e((a['since'] or '')[:16].replace('T', ' '))}</td>"
            f"<td class='muted'>{e(a['last_status'] or '—')} {e((a['last_at'] or '')[:16].replace('T', ' '))}</td></tr>"
            for a in snapshot['agents'])
        parts.append(f"<div class='card'><h2>Агенты и провайдеры</h2><table><tr><th>Агент</th><th>Провайдер</th><th>Модель</th>"
                     f"<th>Профиль</th><th>Последний ран</th></tr>{rows}</table></div>")
    if snapshot.get('stands'):
        rows = ''.join(f"<tr><td><a href='{e(s['url'])}'>{e(s['name'])}</a></td><td>{e(s['url'])}</td><td>{e(s['line'])}</td></tr>"
                       for s in snapshot['stands'])
        parts.append(f"<div class='card'><h2>Стенды</h2><table>{rows}</table></div>")
    if snapshot['quotas']:
        rows = ''.join(f"<tr><td>{e(q['name'])}</td><td><code>{e(q['line'])}</code></td></tr>" for q in snapshot['quotas'])
        parts.append(f"<div class='card'><h2>Подписки — окна и последний выбор аккаунта</h2><table>{rows}</table></div>")
    rows = ''.join(f"<tr><td class='muted'>{e(ev['t'][:16].replace('T', ' '))}</td><td class='k-{e(ev['kind'])}'>"
                   f"{e(KIND_RU.get(ev['kind'], ev['kind']))}</td><td>{e(ev['text'])}</td></tr>" for ev in reversed(events[-150:]))
    parts.append(f"<div class='card'><h2>Журнал</h2><table>{rows or '<tr><td>пока пусто</td></tr>'}</table></div>")
    return (f"<!doctype html><html lang='ru'><head><meta charset='utf-8'><meta http-equiv='refresh' content='60'>"
            f"<meta name='viewport' content='width=device-width,initial-scale=1'><meta name='robots' content='noindex'>"
            f"<title>Сторож multica</title><style>{css}</style></head><body><main>{''.join(parts)}</main></body></html>")


def write_status(cfg, snapshot, events):
    d = cfg.get('status_dir')
    if not d:
        return
    Path(d).mkdir(parents=True, exist_ok=True)
    for name, body in (('index.html', render(snapshot, events)),
                       ('status.json', json.dumps({**snapshot, 'events': events[-150:]}, ensure_ascii=False, indent=1))):
        tmp = Path(d, name + '.tmp')
        tmp.write_text(body)
        os.chmod(tmp, 0o644)
        tmp.replace(Path(d, name))


@contextlib.contextmanager
def run_lock(state):
    """Один процесс владеет снимком и журналом намерений до конца тика."""
    state.parent.mkdir(parents=True, exist_ok=True)
    with state.with_suffix('.run.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def run(cfg, dry):
    with run_lock(STATE) as acquired:
        if not acquired:
            print('Тик пропущен: другой экземпляр сторожа ещё работает', flush=True)
            return
        _run(cfg, dry)


def _run(cfg, dry):
    w = Watch(dry)
    with control.Store().locked() as settings:
        selected = [t for t in control.targets(cfg, settings) if t.get('enabled', True)]
        paused = settings.get('paused', False)
        chains = control.agent_chains(cfg, settings)
    snapshot = {'tick': now_utc().isoformat(timespec='seconds')[:19].replace('T', ' '), 'epics': [], 'agents': [], 'errors': [],
                'paused': paused, 'stands': [], 'agent_names': {**cfg.get('agent_names', {}),
                  **{aid: a['name'] for aid, a in chains.items()}}}
    # Цель на паузе (или весь конвейер) всё равно читается — пульт рисует по снимку доску.
    steps = [(epic['key'], epic['key'], paused or epic.get('paused', False),
              lambda epic=epic, frozen=paused or epic.get('paused', False): run_epic(epic, w, snapshot, frozen=frozen))
             for epic in selected]
    steps += [('провайдеры', None, False, lambda: run_providers(cfg, w, snapshot)),
              ('стенды', None, False, lambda: run_stands(cfg, w, snapshot))]
    workspaces = {t['key']: t.get('workspace') for t in selected}
    for step, target_key, frozen, fn in steps:
        w.target_key = target_key
        w.ws = workspaces.get(target_key)
        try:
            if not frozen:
                w.permit()
            fn()
        except AutomationPaused as e:
            print(str(e))
        except Exception as e:
            msg = f'{step}: {e}'
            w.log('error', msg)
            snapshot['errors'].append(msg + '\n' + traceback.format_exc()[-1200:])
        w.save()
    snapshot['quotas'] = quotas(cfg)
    if not dry:
        write_status(cfg, snapshot, w.state.get('_events', []))


if __name__ == '__main__':
    sys.stdout.reconfigure(line_buffering=True)
    run(json.loads(CONFIG.read_text()), '--dry-run' in sys.argv)
