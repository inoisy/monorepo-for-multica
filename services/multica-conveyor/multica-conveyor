def issue_state(i):
    if i['held'] and i['status'] not in ('done', 'cancelled'):
        return 'paused'
    if i['unmerged'] or i['status'] == 'in_review':
        return 'review'
    return {'done': 'success', 'in_progress': 'running', 'todo': 'running', 'blocked': 'blocked',
            'cancelled': 'canceled', 'canceled': 'canceled'}.get(i['status'], 'created')


def job_state(j):
    if j['status'] in ACTIVE_RUN:
        return 'running'
    if j['status'] == 'completed':
        return 'success'
    if j['status'] == 'failed':
        return 'blocked' if j.get('quota') else 'failed'
    return 'canceled' if j['status'] in ('cancelled', 'canceled') else 'created'


def short_title(t): return re.sub(r'\s*T-\d+\s*$', '', re.sub(r'^[^:]{2,40}:\s*', '', t or ''))


def dur(s):
    if s is None:
        return ''
    return f'{s // 3600} ч {s % 3600 // 60} мин' if s >= 3600 else f'{s // 60} мин {s % 60} с' if s >= 60 else f'{s} с'


