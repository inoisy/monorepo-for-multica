# Yandex Search API v2 credentials
YANDEX_SEARCH_API_KEY= # Get from Yandex Cloud: Service Account → Create static key
YANDEX_FOLDER_ID= # Your Yandex Cloud folder ID (e.g., b1gkdtl7fq8lvn2h33o4)

# Tavily API key (for web-search package)
TAVILY_API_KEY=

# GitHub PAT (for github package - Phase 4)
GITHUB_TOKEN=

# Vision providers (at least one required for vision package)
LOODSEN_API_KEY= # Gemma 4 31B via ai.loodsen.ru
MINIMAX_API_KEY= # MiniMax-VL-01 via api.minimax.io
ZAI_API_KEY= # GLM-4.6V via api.z.ai

# --- web-reader ---
# extractor: defuddle (article, with feed/readability fallbacks) | readability | passthrough
WEB_EXTRACTOR=defuddle
# wall clock for the renderer; must stay under the 60s MCP client timeout
WEB_RENDER_TIMEOUT_MS=25000

# CloakBrowser launch options. Most sites work without these; the ones below
# unlock RU geo-gated and DataDome-class anti-bot.
# SOCKS5/HTTP proxy URL. Use a regional proxy (RU for avito/yandex).
# WEB_PROXY_URL=socks5://user:pass@host:1080
# Auto-pick timezone/locale from proxy IP. Needs `npm i mmdb-lib`.
# WEB_GEOIP=0
# Persistent browser profile dir; cookies/storage carry across requests.
# WEB_USER_DATA_DIR=/var/lib/web-reader/profile
# Human behavior preset: default (fast) | careful (slower, more human-like)
WEB_HUMAN_PRESET=default
# 0 disables humanized mouse/keyboard/scroll (faster, easier to detect)
# WEB_HUMANIZE=1
# BCP 47 locale passed to Chromium; affects Date, Intl, Accept-Language.
# Leave empty to auto-derive from the URL's TLD (.ru → ru-RU, .de → de-DE).
WEB_LOCALE=

# Per-host overrides. Format: domain.tld=key:value,key:value;other.tld=key:value
# Keys: proxy, geoip, humanize, humanPreset (default|careful), locale,
#       viewport (WxH), releaseChannel (stable|preview).
# Bare flag (no value) sets boolean to true. Leading `*.` matches subdomains.
# Examples:
#   WEB_HOST_RULES="*.avito.ru=proxy,humanPreset:careful;yandex.ru=locale:ru-RU"
# Rules listed here win over the built-in ones (*.avito.ru, *.wildberries.ru).
WEB_HOST_RULES=
# Hosts whose top-level navigations the renderer refuses, comma-separated.
# Default: sso.passport.yandex.ru — Yandex properties (kinopoisk, dzen) bounce
# through it on every fresh session, and when that hop dies the browser scrapes
# Chrome's error page instead of the site. Set empty to follow every redirect.
# WEB_BLOCK_NAV_HOSTS=sso.passport.yandex.ru
# Browser viewport; default 1920x1080
# WEB_VIEWPORT_WIDTH=1920
# WEB_VIEWPORT_HEIGHT=1080
# preview gets newer fingerprint patches earlier than stable
WEB_RELEASE_CHANNEL=stable

# 1 logs every renderer poll to stderr
# WEB_DEBUG=1

# Docker port mapping (host ports, container always uses 3000)
# tavily=3071, yandex-search=3072, github=3073, vision=3074, web-reader=3075
