# /etc/multica-tasks-mcp/env — root:root, 0600. Значения подставляет оператор (ROOT-STEPS.md), в репозитории их нет.

# Клиент по умолчанию «Claude (MCP)» (claude.ai Евгения). Ключ — для заголовка Authorization: Bearer <ключ>, не короче 32 символов.
MULTICA_MCP_KEY=

# PAT сервисного пользователя «Claude (MCP)» (роль member). Не ключ коннектора и не токен Евгения.
MULTICA_PAT=

# Личные ключи сотрудников: путь к JSON-файлу [{"name": "Илья", "key": "…", "token": "mul_…", "workspaces": ["stt"]}].
# Владелец — UID/GID сервиса, права 0600 (иначе сервис не стартует). Ключ входа → собственный PAT человека: действия в
# Multica идут от него. workspaces необязателен (по умолчанию — MULTICA_MCP_WORKSPACES). Без файла работает только клиент по умолчанию.
MULTICA_MCP_CLIENTS=/etc/multica-tasks-mcp/clients.json

# Бэкенд Multica на этом же сервере: его адрес получает CLI в MULTICA_SERVER_URL.
MULTICA_API_URL=http://127.0.0.1:8080

# Воркспейсы клиента по умолчанию и по умолчанию для файла клиентов: slug или id через запятую, либо * — все воркспейсы владельца PAT.
MULTICA_MCP_WORKSPACES=stt

# Вход через OAuth (claude.ai / Claude Code подключаются по URL и входу в Multica, без ключей).
# Файл с ключом шифрования выданных PAT: Fernet-ключ (python3 -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'),
# владелец — UID/GID сервиса, права 0600, хранить отдельно от каталога состояния. Не задан — OAuth выключен, работают только ключи.
# MULTICA_MCP_OAUTH_KEY_FILE=/etc/multica-tasks-mcp/oauth.key
# Публичный адрес сервиса (issuer; resource = адрес + /mcp):
# MULTICA_MCP_PUBLIC_URL=https://multica.yakutov.com
# Воркспейсы OAuth-пользователя не настраиваются: доступны все, где он состоит в Multica. Ключам: "workspaces": ["*"] в clients.json.

# Необязательно (значения по умолчанию):
# MULTICA_BIN=/usr/local/bin/multica
# MULTICA_MCP_RUN_DIR=            # где создаются пустые cwd запусков CLI (в контейнере — tmpfs /run/multica-cli)
# MULTICA_MCP_PORT=8101
# MULTICA_MCP_HOST=127.0.0.1
# MULTICA_MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
# MULTICA_MCP_ALLOWED_HOSTS=multica.yakutov.com,127.0.0.1,localhost
