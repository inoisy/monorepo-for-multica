# Bitrix24 Sphere API
B24_WEBHOOK_URL=https://sphere.loodsen.ru/rest/<USER_ID>/<TOKEN>/
# B24_USER_ID=  # auto-extracted from B24_WEBHOOK_URL, override only if needed

# Optional
# SPHERE_BASE_URL=https://sphere.loodsen.ru

# Bitrix24 group (Kanban) IDs to fetch stages from (comma-separated, required for stage auto-detection)
B24_GROUP_IDS=

# Title substrings for custom stages to treat as open/in-progress (case-insensitive, comma-separated).
# Stages with SYSTEM_TYPE=NEW/WORK are always included automatically.
# B24_OPEN_STAGE_TITLES=В работе

# MCP server write operations (default: disabled)
# MCP_WRITE_ENABLED=true

# --- Git sync (sphere-tasks) ---
# Абсолютный путь к локальному клону sphere-tasks репо
TASKS_REPO_PATH=/Users/you/projects/sphere-tasks
# Секрет для верификации входящих вебхуков от Bitrix
# WEBHOOK_SECRET=
# GitHub PAT + репо для repository_dispatch (VPS → GitHub Actions)
# GITHUB_TOKEN=
# GITHUB_REPO=org/sphere-integration